# Copy to .env and adjust. docker compose reads .env automatically.

# Folder that contains the Git repositories Relay should work on.
# It is mounted at this same path inside the container.
RELAY_REPOS=/home/you/projects

# Where Relay keeps its task list, conversations and worktrees.
# Also mounted at the same path. Keep it separate from any host Relay install.
RELAY_DATA=/home/you/relay-data

# Your host home directory, where the agent logins live (~/.codex, ~/.claude, ...).
HOST_HOME=/home/you

# Linux: your host user's ids, so files written by agents keep your ownership.
#   id -u    and    id -g
RELAY_UID=1000
RELAY_GID=1000

RELAY_PORT=8767

# Optional. Needed on Windows and macOS hosts, where gh keeps its token in the
# system keychain. Get one with: gh auth token
GH_TOKEN=

# Optional. Google Workspace accounts need this for Gemini CLI.
GOOGLE_CLOUD_PROJECT=

# Optional. Pin agent CLI versions for reproducible builds.
CODEX_VERSION=latest
CLAUDE_VERSION=latest
GEMINI_VERSION=latest
